<Project Sdk="Microsoft.NET.Sdk">
  <!-- Differential tests: run the fixtures in a real SQL Server and check the output against the IR. A
       project of its own so that SqlClient and Testcontainers stay out of the other tests. See README.md. -->
  <PropertyGroup>
    <!-- xunit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- SqlClient throws NotSupportedException in invariant globalization mode (it needs culture data for
         collations), so this project, unlike the CLI and Haruspex.Tests, runs with ICU. Stated, though it is the
         default, so that nobody turns it on here to match them. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- Support both test projects use: finding the fixtures and running the emit-check npm package. -->
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <!-- The SDK's own C# compiler, which ClrAssembly runs to build the tests' .NET Framework assembly from source: no package. -->
    <AssemblyMetadata Include="CSharpCompiler" Value="$(RoslynTargetsPath)/bincore/csc.dll" />
    <AssemblyMetadata Include="DotNetHost" Value="$(DOTNET_HOST_PATH)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Testcontainers.MsSql" />
    <!-- Overrides a vulnerable transitive version: see Directory.Packages.props. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Haruspex.Ir\Haruspex.Ir.csproj" />
    <!-- SqlProject, the composition of the front-end layers, lives in the CLI. -->
    <ProjectReference Include="..\..\src\Haruspex.Cli\Haruspex.Cli.csproj" />
    <!-- The Zod acceptance check runs every seeded output through the generated schemas. -->
    <ProjectReference Include="..\..\src\Haruspex.Config\Haruspex.Config.csproj" />
    <ProjectReference Include="..\..\src\Haruspex.Emit.Zod\Haruspex.Emit.Zod.csproj" />
    <ProjectReference Include="..\..\src\Haruspex.Emit.JsonSchema\Haruspex.Emit.JsonSchema.csproj" />
    <ProjectReference Include="..\..\src\Haruspex.Emit.Mssql\Haruspex.Emit.Mssql.csproj" />
  </ItemGroup>
</Project>
